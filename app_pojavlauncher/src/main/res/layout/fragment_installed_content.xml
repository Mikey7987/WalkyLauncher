<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_app"
    android:paddingHorizontal="@dimen/fragment_padding_medium"
    android:paddingTop="@dimen/fragment_padding_medium">

    <TextView
        android:id="@+id/installed_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/content_installed_title"
        android:textColor="@color/primary_text"
        android:textSize="@dimen/_16ssp"
        android:textStyle="bold" />

    <!-- Which profile we are looking at -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_medium"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/installed_target_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:id="@+id/installed_target_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:padding="@dimen/padding_medium"
            android:text="@string/content_target_change"
            android:textColor="@color/accent"
            android:textSize="@dimen/_12ssp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_medium"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/installed_type_mod"
                style="@style/ContentChip"
                android:text="@string/content_type_mods" />

            <TextView
                android:id="@+id/installed_type_resourcepack"
                style="@style/ContentChip"
                android:text="@string/content_type_resource_packs" />

            <TextView
                android:id="@+id/installed_type_shader"
                style="@style/ContentChip"
                android:text="@string/content_type_shaders" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/installed_add_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_large"
        android:background="@drawable/bg_accent_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingVertical="@dimen/padding_large"
        android:text="@string/content_installed_add"
        android:textColor="@color/on_accent"
        android:textSize="@dimen/_13ssp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/padding_large">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/installed_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/padding_large" />

        <TextView
            android:id="@+id/installed_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/content_installed_empty"
            android:textColor="@color/secondary_text"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
